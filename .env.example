# TradeStack MCP — environment configuration
# Copy to .env and fill in values. Nothing in this file is required for v0 core (TV public APIs).

# --- Transport ---
# stdio (default for desktop clients like Claude Desktop) or http (for hosted/remote)
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0

# --- Persistence (optional — enables watchlists, scans, journal across sessions) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Webhook ingress (optional — receive TradingView alerts as MCP context) ---
WEBHOOK_BASE_URL=
WEBHOOK_SHARED_SECRET=

# --- Optional broker plugins (loaded only when set) ---
# TradeLocker
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=

# Alpaca (US stocks/crypto)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# NinjaTrader 8 — via local ATI (file-based, no creds needed) or CrossTrade REST
NT8_ATI_PATH=
CROSSTRADE_API_KEY=

# MT5 (via MetaApi cloud or local gateway)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# cTrader Open API
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# --- Optional data feed plugins ---
POLYGON_API_KEY=
DATABENTO_API_KEY=

# --- Logging ---
LOG_LEVEL=info
