{
  "name": "tradestack-mcp",
  "version": "1.0.0",
  "description": "Market Context Protocol for TradingView and every major trading platform. Connect. Query. Analyze. Trade Smarter.",
  "type": "module",
  "license": "MIT",
  "author": "VZT Tech Consulting",
  "bin": {
    "tradestack-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^5.0.1",
    "lru-cache": "^11.0.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tradingview",
    "tradelocker",
    "ninjatrader",
    "metatrader",
    "ctrader",
    "trading",
    "pine-script",
    "claude",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vonzelle-vzt/tradestack-mcp.git"
  },
  "homepage": "https://github.com/vonzelle-vzt/tradestack-mcp#readme",
  "bugs": {
    "url": "https://github.com/vonzelle-vzt/tradestack-mcp/issues"
  }
}
